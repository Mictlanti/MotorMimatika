                    "type": "title",
                    "text": "Multiplicación de potencias"
                },
                {
                    "type": "card_example",
                    "content": [
                        {
                            "type": "short_example",
                            "text": "1) (-ab)^2 = (-ab)(-ab) = a^2b^2"
                        },
                        {
                            "type": "short_example",
                            "text": "2) (-ab)^3=(-ab)(-ab)(-ab)= -a^3b^3"
                        },
                        {
                            "type": "large_example",
                            "text": "(-ab)^2 = (-ab)(-ab) = a^2b^2"
                        },
                        {
                            "type": "large_example",
                            "text": "Pasos:"
                        },
                        {
                            "type": "large_example",
                            "text": "- Multiplicar dos veces (-ab) es:"
                        },
                        {
                            "type": "large_example",
                            "text": "ab * ab = a^2b^2"
                        },
                        {
                            "type": "large_example",
                            "text": "- * - = +"
                        },
                        {
                            "type": "large_example",
                            "text": "... (-ab)(-ab) = +a^2b^2"
                        }
                    ]
                },
                {
                    "type": "title",
                    "text": "Verdadero o falso"
                },
                {
                    "type": "body",
                    "text": "(-3a)^3 = (-3a)(-3a)(-3a) = 27a^3",
                    "isMathText": true
